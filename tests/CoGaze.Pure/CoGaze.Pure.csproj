<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles every assembly marked noEngineReferences against netstandard2.1 with C# 9 — the
    same API surface and language version as Unity 6 — so code that builds here builds in Unity.
    Sources are linked, not copied. Add a folder here when a new pure assembly is created.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <Shared>..\..\packages\com.cogaze.shared\Runtime\</Shared>
    <Expert>..\..\expert-app\Assets\Scripts\</Expert>
    <Worker>..\..\worker-app\Assets\Scripts\</Worker>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Shared)Core\**\*.cs" />
    <Compile Include="$(Shared)Clock\**\*.cs" />
    <Compile Include="$(Shared)Logging\**\*.cs" />
    <Compile Include="$(Shared)Config\**\*.cs" />
    <Compile Include="$(Shared)Protocol\**\*.cs" />
    <Compile Include="$(Shared)Transport.Loopback\**\*.cs" />
    <!-- Transport.WebRtc is an engine assembly; only its engine-free Pure/ folder is built here. -->
    <Compile Include="$(Shared)Transport.WebRtc\Pure\*.cs" />
    <Compile Include="$(Expert)Sources\Fake\**\*.cs" />
    <Compile Include="$(Expert)Sources\Osc\**\*.cs" />
    <Compile Include="$(Expert)Pipeline\**\*.cs" />
    <Compile Include="$(Expert)Experiment\**\*.cs" />
    <Compile Include="$(Expert)Calibration\**\*.cs" />
    <Compile Include="$(Expert)View2D\**\*.cs" />
    <Compile Include="$(Expert)View3D\Model\**\*.cs" />
    <Compile Include="$(Worker)Cue\*.cs" />
    <Compile Include="$(Worker)Replay\**\*.cs" />
    <Compile Include="$(Worker)Capture\*.cs" />
    <Compile Include="$(Worker)Session\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Unity ships Newtonsoft 13 via com.unity.nuget.newtonsoft-json -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
  </ItemGroup>
</Project>
